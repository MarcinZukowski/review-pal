{
  "manifest_version": 3,

  "name": "Review Pal",
  "version": "0.7.0",
  "description": "Code-reviewer life improvements for GitHub and Crucible",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://*/fisheye/cru/*",
    "https://github.com/*/pull/*"
  ],

  "web_accessible_resources": [{
    "resources": ["images/*"],
    "matches": ["https://*/*"]
  }],

  "background": {
    "service_worker": "Background.js",
    "scripts": ["Background.js"]
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "review-pal@marcinzukowski.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [{
    "run_at": "document_end",
    "css": ["styles.css"],
    "js": [
      "3rd/jquery-3.3.1.slim.min.js",
      "BackendCrucible.js",
      "BackendGitHub.js",
      "BackendGitHubReact.js",
      "Core.js",
      "DiffBlock.js",
      "DiffLine.js"
    ],
    "matches": [
      "https://*/fisheye/cru/*",
      "https://github.com/*/pull/*"
    ]
  }]
}
